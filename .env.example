# Cadence · configuration (copiez ce fichier en .env)

# Base PostgreSQL. Avec Supabase : Project Settings → Database → Connection string → « Session pooler ».
# Sans DATABASE_URL, Cadence utilise PostgreSQL embarqué (PGlite) dans server/data.
DATABASE_URL=

# Active Claude (sinon : mode démo)
ANTHROPIC_API_KEY=
CADENCE_MODEL=claude-opus-5-5

# Écoute réseau. Par défaut 127.0.0.1 (cet ordinateur seulement). La connexion de démonstration n'a pas de mot de passe :
# HOST=0.0.0.0 ou NODE_ENV=production exigent CADENCE_DEMO=1 pour accepter ce risque.
HOST=
CADENCE_DEMO=

# Secret de signature des sessions, au moins 32 caractères. Obligatoire en production ou avec DATABASE_URL ; sinon généré localement.
COOKIE_SECRET=

# Clé de chiffrement des secrets en base (mot de passe SMTP des organisations).
# Au moins 32 caractères, obligatoire en production ou avec DATABASE_URL. La changer rend les mots de passe enregistrés illisibles.
CADENCE_SECRET_KEY=

PORT=4000
