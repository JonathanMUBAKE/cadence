# Cadence · configuration (copiez ce fichier en .env)

# Base PostgreSQL. Avec Supabase : Project Settings → Database → Connection string → « Session pooler ».
# Sans DATABASE_URL, Cadence utilise PostgreSQL embarqué (PGlite) dans server/data.
DATABASE_URL=

# Active Claude (sinon : mode démo)
ANTHROPIC_API_KEY=
CADENCE_MODEL=claude-opus-5-5

# Écoute réseau. Par défaut 127.0.0.1 (cet ordinateur seulement). HOST=0.0.0.0 exige PUBLIC_URL.
HOST=
# Adresse publique, utilisée dans les liens envoyés par e-mail. Obligatoire en production ou sur le réseau.
PUBLIC_URL=
# Seulement derrière un proxy de confiance : nombre de proxys devant Cadence (1 le plus souvent) ou leurs adresses (10.0.0.0/8).
TRUST_PROXY=
# 1 : données d'exemple et connexion sans mot de passe. Usage local uniquement.
CADENCE_DEMO=
# SMTP de la plateforme. Seul à envoyer les liens de réinitialisation : sans lui, « mot de passe oublié » n'envoie rien
# et l'administrateur système doit générer le lien. Sert aussi de secours aux organisations sans SMTP.
# Exemple : smtps://utilisateur:motdepasse@smtp.exemple.com
SMTP_URL=
SMTP_FROM=
# 1 : réaffiche au démarrage le lien de création d'un administrateur système (accès perdu).
CADENCE_BOOTSTRAP=

# Secret de signature des sessions, au moins 32 caractères. Obligatoire en production ou avec DATABASE_URL ; sinon généré localement.
COOKIE_SECRET=

# Clé de chiffrement des secrets en base (mot de passe SMTP des organisations).
# Au moins 32 caractères, obligatoire en production ou avec DATABASE_URL. La changer rend les mots de passe enregistrés illisibles.
CADENCE_SECRET_KEY=

PORT=4000
